<Window x:Class="Project_03_TestPilot_20260617.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TestPilot v1.0.1 - 设置" Height="240" Width="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="目标程序路径：" FontWeight="Bold"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtPath" Grid.Column="0" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="浏览..." Click="BrowseClick" Width="80"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="启动热键: " VerticalAlignment="Center"/>
            <TextBox x:Name="txtLaunchKey" Text="F11" IsReadOnly="True"
                     Width="100" TextAlignment="Center" FontWeight="Bold"
                     Margin="0,0,16,0"
                     GotFocus="KeyBox_GotFocus"
                     PreviewKeyDown="LaunchKey_PreviewKeyDown"/>
            <TextBlock Text="关闭热键: " VerticalAlignment="Center"/>
            <TextBox x:Name="txtKillKey" Text="F12" IsReadOnly="True"
                     Width="100" TextAlignment="Center" FontWeight="Bold"
                     GotFocus="KeyBox_GotFocus"
                     PreviewKeyDown="KillKey_PreviewKeyDown"/>
        </StackPanel>

        <StatusBar Grid.Row="3" Margin="0,12,0,0" VerticalAlignment="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="就绪"/>
            </StatusBarItem>
        </StatusBar>

        <Button Grid.Row="4" Content="保存" Click="SaveClick" Height="30" Margin="0,8,0,0"/>
    </Grid>
</Window>

